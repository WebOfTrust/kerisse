########################################
### SECRET ENVIRONMENT VARIABLES ###
########################################

# GITHUB
# Classic PAT (ghp_…) or fine-grained PAT (github_pat_…). Raw token only — do not
# prefix with "Bearer"/"token" here; the scraper adds Bearer automatically.
# Required for indexing repos in config/github-repos.json (anonymous limit is 60/hr).
GITHUB_AUTH_TOKEN="<your_github_auth_token>"
# for creating Github issues:
GITHUB_ISSUE_AUTH_TOKEN="<your_github_issue_auth_token>"


# DOWNLOADS. Add a trailing slash.
# EXAMPLE FOR MACS: KERISSE_BACKUPS_DIR=$HOME/Downloads/ 
KERISSE_BACKUPS_DIR="<your_kerisse_backups_dir>"

# Hostinger / keri.foundation (npm run upload:search-data)
# KERISSE_SSH_HOST=123.456.789.10
# KERISSE_SSH_PORT=65002
# KERISSE_SSH_USER=u123456789
# KERISSE_REMOTE_DIR=domains/keri.foundation/public_html/kerisse
# KERISSE_DATASET_URL=https://keri.foundation/kerisse/dataset

# Build-time URL for shards (GitHub Actions sets this; local default is search-index/)
# SEARCH_INDEX_BASE_URL=https://keri.foundation/kerisse/search-index/

########################################
### NON-SECRET ENVIRONMENT VARIABLES ###
########################################

# SEARCH INDEX DIRECTORY
SEARCH_INDEX_DIR="scraper"
SEARCH_INDEX_CONFIG_DIR="config"
SEARCH_INDEX_ENTRIES_DIR="search-index-entries"
SEARCH_INDEX_SITEMAPS_DIR="sitemaps"
SEARCH_INDEX_TEMP_DIR="scraper/temp"

# SITEMAP OF INDEXED WEBSITES VIA FILE SYSTEM
INDEX_OVERVIEW_FILE="output/indexed-in-KERISSE.html"
# SITEMAP OF INDEXED WEBSITES VIA HTTP
INDEX_OVERVIEW_HTTP="/kerisse/output/indexed-in-KERISSE.html"
